# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不要提交。
#
# 两套命名都保留：
#   VITE_*   客户端可读。Vite 只会把 VITE_ 前缀的变量注入前端代码，
#            src/utils/supabase.ts 读的是这两个。
#   不带前缀  即 Supabase 官方命名，供将来的服务端脚本 / Edge Functions 使用。
#
# VITE_SUPABASE_ANON_KEY 是公开密钥，可以出现在客户端；真正的权限由 Supabase RLS 策略控制。
# 任何情况下都不要把 service_role key 写进这里或前端代码。
#
# 本项目默认不接 Supabase：留空时数据层自动降级到本地 mock + localStorage（见 T02）。

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- 信息雷达远程 feed ----------
#
# 留空时：雷达用随 App 打包的那份数据（src/mock/infoFeed.generated.json），
#        点「刷新」不会联网，「数据抓取于」显示的是打包时那次抓取的时间。
#
# 填上后：点「刷新」会从这个地址拉 JSON，拉成功写入本地缓存（6 小时内直接命中缓存）。
#        想在不重新打包的情况下更新内容，就把它指向一个静态托管的 feed 文件。
#
# 这个文件由 `node tools/fetch-info-feed.mjs` 生成，
# 也可以手工维护（字段格式见 docs/INFO_FEED.md）。
# 常见做法：把生成的文件传到任意静态托管（GitHub Pages / 对象存储 / Supabase Storage），
# 把直链填到这里。
#
# 注意：不能直接填国家统计局等政府站点地址 —— 那里是 HTML，
# 不是 feed JSON，而且正文抓取要放在生成脚本里做（见 docs/INFO_FEED.md）。

VITE_INFO_FEED_URL=
